# Development image with hot reload via air.
FROM golang:1.23-alpine

RUN apk add --no-cache git tzdata wget

WORKDIR /app

RUN go install github.com/air-verse/air@v1.61.0

# The source tree is bind-mounted, so warm the module cache from the manifests
# only — that keeps a rebuild off the critical path on every container start.
COPY go.mod go.sum ./
RUN go mod download

EXPOSE 8080
CMD ["air", "-c", ".air.toml"]
