# Family Dashboard – Umgebungsvariablen
# "make setup" erzeugt daraus eine .env mit frischem JWT_SECRET.
# Die .env gehört NICHT ins Git (siehe .gitignore).

# Signaturschlüssel für die Login-Cookies. Mindestens 32 Zeichen.
# Neu erzeugen mit:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_32_CHARS_MINIMUM_REPLACE_IN_PRODUCTION

# Wetter-Standort (Standard: Wien)
WEATHER_LAT=48.2082
WEATHER_LON=16.3738
WEATHER_TZ=Europe/Vienna

TZ=Europe/Vienna

# Netzwerk-Bindung:
#   0.0.0.0       = im ganzen LAN erreichbar (zum Testen bequem)
#   192.168.1.20  = nur über diese eine Adresse (empfohlen im Dauerbetrieb)
BIND_ADDR=0.0.0.0
HTTP_PORT=8088
HTTPS_PORT=8443

# Benutzerkennung, unter der das Backend läuft. Muss dem Besitzer des
# Ordners backend/data entsprechen, sonst kann die Datenbank nicht angelegt
# werden. "make setup" trägt hier automatisch die eigene Kennung ein.
# Selbst herausfinden:  id -u   und   id -g
PUID=1000
PGID=1000

# Musik-Ordner auf DIESEM Rechner. Er wird schreibgeschützt in den Container
# eingehängt. Voreinstellung ist ein leerer Ordner im Projekt; dann ist die
# Musik-Kachel zwar da, findet aber nichts.
#
# Beispiele:
#   MUSIC_HOST_DIR=/media/festplatte/AUDIO
#   MUSIC_HOST_DIR=/mnt/nas/musik
MUSIC_HOST_DIR=./backend/data/music

# Pfad INNERHALB des Containers. Leer lassen schaltet das Musik-Modul ganz ab —
# dann wird auch nicht im Hintergrund eingelesen.
MUSIC_DIR=/app/audio

# info | debug | warn
LOG_LEVEL=info
